NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Session cookie signing secret. Generate a real random value for anything beyond local dev:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Google OAuth (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly.
# Leave both empty to fall back to POST /api/auth/dev-login for local testing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Comma-separated emails that get ADMIN / REVIEWER on first sign-in (everyone else starts as OPERATOR).
ADMIN_EMAILS=
REVIEWER_EMAILS=

# Bearer tokens for machine callers, format "token:actor:ROLE,token2:actor2:ROLE2". Empty = no bearer access.
SERVICE_TOKENS=

# Google Gemini (https://aistudio.google.com/apikey). Leave empty to use the
# deterministic heuristic Operations Assistant and Risk engine instead --
# both work fully without this key, just without natural-language reasoning
# on top of the same grounded evidence.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

MAX_UPLOAD_BYTES=5242880
MAX_BATCH_SIZE=5000
MAX_RETRIES=3
API_CONCURRENCY=32
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
